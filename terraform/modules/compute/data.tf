# Always deploy on the latest Amazon Linux 2023 AMI rather than hardcoding
# an AMI ID, which would go stale and differ per region.
data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}
